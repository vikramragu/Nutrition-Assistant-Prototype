# Groq API key — used starting Phase 2 (model client). Never expose this to the frontend.
GROQ_API_KEY=

# Optional: override the default model (openai/gpt-oss-120b).
# GROQ_MODEL=

# Postgres connection string — used starting Phase 1 (data model/persistence).
# Local dev (matches docker-compose.yml):
DATABASE_URL=postgresql+psycopg://nutrition:nutrition@localhost:5432/nutrition

# Comma-separated list of origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:3000
